.button_shelf_slot_frame {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(4, 151, 255, 0.27);
    border-right-color: rgba(4, 151, 255, 0.27);
    border-top-color: rgba(4, 151, 255, 0.27);
    border-bottom-color: rgba(4, 151, 255, 0.27);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
