<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Local/UI%20Toolkit/USS/SampleStyle.uss?fileID=7433441132597879392&amp;guid=b7387224b11979345bd1dd1a944d2ffd&amp;type=3#SampleStyle" />
    <ui:VisualElement style="flex-direction: column; height: 100%; align-items: flex-start; width: 100%; position: relative; bottom: 0; right: 0;">
        <ui:Button name="char-button-1" class="button-character" style="background-image: none;" />
        <ui:Button display-tooltip-when-elided="true" name="char-button-2" class="button-character" />
        <ui:Button display-tooltip-when-elided="true" name="char-button-3" class="button-character" />
