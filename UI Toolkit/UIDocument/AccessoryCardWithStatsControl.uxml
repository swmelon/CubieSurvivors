    <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 450px; height: 700px; align-items: center; justify-content: center; transition-duration: 1s;">
        <ui:VisualElement name="fx-card" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Local/UI%20Toolkit/UIFX.renderTexture?fileID=8400000&amp;guid=df30f8a58dceb1046ad580c2ac35bc00&amp;type=2#UIFX&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; position: absolute; width: 100%; height: 100%; display: flex; top: 0; left: 1px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="button-card" style="display: none;" />
        <ui:VisualElement name="image-card" style="width: 75%; height: 82%; background-image: url(&quot;project://database/Assets/Local/Art/Texture/CardBackPlate/grey_button09.png?fileID=21300000&amp;guid=24ecf6ad055061c4a84b9cd1f9289a93&amp;type=3#grey_button09&quot;); -unity-background-image-tint-color: rgb(108, 108, 108);">
            <ui:VisualElement name="image" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Local/Art/IconExports/Accessory/Hats/Lp_BaseballHat01.png?fileID=2800000&amp;guid=f4d3d12559587cf4d80ef5003baa2d74&amp;type=3#Lp_BaseballHat01&quot;); height: 50%; align-items: center; justify-content: center;">
                <ui:VisualElement name="image-particle" style="position: relative; background-image: none; width: 256px; height: 256px;" />
                <ui:VisualElement name="image-symbol" style="flex-grow: 1; position: absolute; width: 96px; height: 96px; margin-top: 0; margin-right: 0; background-image: url(&quot;project://database/Assets/ThirdParty/Clean%20Vector%20Icons/T_3_bottle_full_.png?fileID=2800000&amp;guid=9967dc9c6c023804490a2f656ff50533&amp;type=3#T_3_bottle_full_&quot;); left: auto; top: 0; right: 0; margin-bottom: 0; margin-left: 0; display: none;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center; height: 8%; -unity-font: url(&quot;project://database/Assets/ThirdParty/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;);">
                <ui:Label tabindex="-1" text="Alien Antenna" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-name" class="card-label label-card" style="-unity-font: url(&quot;project://database/Assets/ThirdParty/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf?fileID=12800000&amp;guid=585188cdc4600544eb408bee749e4b3a&amp;type=3#ThaleahFat_TTF&quot;); -unity-font-style: normal; color: rgb(255, 255, 255); font-size: 34px; height: 100%;" />
                <ui:VisualElement name="element-points-left" class="button-stats-control" style="position: absolute; align-items: center; flex-direction: row; justify-content: center; width: 170px; bottom: 40px;">
