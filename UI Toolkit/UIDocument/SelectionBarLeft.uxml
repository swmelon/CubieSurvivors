        <ui:VisualElement name="select-bar" style="position: absolute; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; height: 20%; width: 20px; background-color: rgb(255, 194, 112); transition-duration: 0.2s; transition-timing-function: ease-in; background-image: none; left: 0;" />
    </ui:VisualElement>
