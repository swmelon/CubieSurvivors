#MySlider Label {
    display: none;
}

#MySlider #unity-drag-container {
    margin-top: 25px;
    margin-bottom: 25px;
    margin-left: 40px;
    margin-right: 40px;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    overflow: hidden;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-left-color: rgb(100, 100, 100);
    border-right-color: rgb(100, 100, 100);
    border-top-color: rgb(100, 100, 100);
    border-bottom-color: rgb(100, 100, 100);
}

#MySlider #unity-tracker {
    flex-grow: 1;
    top: 0;
    background-color: rgb(0, 0, 0);
    position: relative;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.11);
    border-right-color: rgba(0, 0, 0, 0.11);
    border-top-color: rgba(0, 0, 0, 0.11);
    border-bottom-color: rgba(0, 0, 0, 0.11);
}

#MySlider #unity-dragger {
    background-color: rgba(0, 255, 9, 0.45);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    width: 20px;
    height: 100%;
    top: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.bar {
    width: 2000px;
    height: 100%;
    background-color: rgb(0, 213, 1);
    align-self: flex-end;
}

.newdragger {
    position: absolute;
    width: 120px;
    height: 120px;
    background-image: url("project://database/Assets/ThirdParty/PetterSunnyVR/Sprites/Kenny%20Topdown%20Tanks%20Redux/PNG/Retina/crateWood_side.png?fileID=2800000&guid=09cde87822c681d4f8b5c238ac92550a&type=3#crateWood_side");
}

#MyEnumField Label {
    display: none;
}

#MyEnumField TextElement {
    font-size: 40px;
    -unity-text-align: middle-center;
}

#MyEnumField VisualElement {
    background-color: rgba(0, 0, 0, 0);
}

#MyDropdown Label {
    display: none;
}

#MyDropdown PopupTextElement {
    font-size: 40px;
    -unity-text-align: middle-center;
}

#MyDropdown VisualElement {
    background-color: rgba(0, 0, 0, 0);
}

