<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Local/UI%20Toolkit/USS/SampleStyle.uss?fileID=7433441132597879392&amp;guid=b7387224b11979345bd1dd1a944d2ffd&amp;type=3#SampleStyle" />
    <ui:VisualElement style="flex-direction: row; width: 100%; height: 100%;">
        <ui:VisualElement name="VisualElement" style="height: 100%; width: 30%;" />
        <ui:VisualElement name="popup-screen-anchor" style="width: 40%; height: 100%; align-items: center; justify-content: center; display: flex;">
            <ui:VisualElement name="container" class="label-title" style="width: 100%; height: 40%; background-color: rgb(155, 123, 146); border-left-color: rgba(255, 255, 255, 0.24); border-right-color: rgba(255, 255, 255, 0.24); border-top-color: rgba(255, 255, 255, 0.24); border-bottom-color: rgba(255, 255, 255, 0.24); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; top: auto; opacity: 1;">
                <ui:Label tabindex="-1" text="Are you sure? " parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-notice" style="font-size: 50px; height: 50%; white-space: pre-wrap;" />
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: center; height: 50%;">
                    <ui:Button text="1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="button-left" class="button-skyblue" style="height: 100%; width: 40%; font-size: 56px; margin-top: 0; margin-right: 5%; margin-left: 0; margin-bottom: 0;" />
                    <ui:Button text="2" parse-escape-sequences="true" display-tooltip-when-elided="true" name="button-right" class="button-skyblue" style="height: 100%; width: 40%; font-size: 56px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 5%;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="width: 105px;" />
    </ui:VisualElement>
</ui:UXML>
