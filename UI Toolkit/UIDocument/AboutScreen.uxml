<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Local/UI%20Toolkit/USS/SampleStyle.uss?fileID=7433441132597879392&amp;guid=b7387224b11979345bd1dd1a944d2ffd&amp;type=3#SampleStyle" />
    <ui:VisualElement style="flex-direction: row; width: 100%; height: 100%; align-items: center; justify-content: center;">
        <ui:VisualElement name="container" class="label-title" style="width: 80%; height: 90%; background-color: rgba(155, 123, 146, 0.28); border-left-color: rgba(255, 255, 255, 0.24); border-right-color: rgba(255, 255, 255, 0.24); border-top-color: rgba(255, 255, 255, 0.24); border-bottom-color: rgba(255, 255, 255, 0.24); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; top: auto; opacity: 1; align-items: center;">
            <ui:VisualElement name="VisualElement" style="align-items: center; height: auto; margin-top: 10px; margin-right: 10px; margin-bottom: 20px; margin-left: 10px;">
                <ui:Label tabindex="-1" text="About : Cubie Survivors" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-notice" style="font-size: 60px; white-space: pre-wrap; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;" />
                <ui:VisualElement name="bar" style="background-size: 100% 1%; border-left-color: rgba(73, 73, 73, 0.54); border-right-color: rgba(73, 73, 73, 0.54); border-top-color: rgba(73, 73, 73, 0.54); border-bottom-color: rgba(73, 73, 73, 0.54); border-bottom-width: 4px; height: 4px; background-color: rgba(213, 9, 9, 0); border-top-width: 4px; border-right-width: 4px; border-left-width: 4px; width: 100%; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px;" />
                <ui:Label text="Designed and developed by swmelon from HWDP.&#10;Current version: 1.0 – Updates on the way!" style="-unity-font-style: normal; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; -unity-font-definition: url(&quot;project://database/Assets/Local/UI%20Toolkit/LilitaOne-Regular%20SDF.asset?fileID=11400000&amp;guid=6a51d19839e1583429dcb7a35e53e952&amp;type=2#LilitaOne-Regular SDF&quot;); font-size: 42px;" />
                <ui:Label text="This game is subject to our Terms of Service and Privacy Policy.&#10;Please review them for more details." style="font-size: 36px; display: flex; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;" />
                <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                    <ui:Button text="Terms of Service" name="button-terms-of-service" style="width: 320px;" />
                    <ui:Button text="Privacy Policy" name="button-privacy-policy" style="width: 320px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="VisualElement" style="align-items: center; height: auto; margin-top: 10px; margin-right: 10px; margin-bottom: 20px; margin-left: 10px;">
                <ui:Label tabindex="-1" text="Credits" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-notice" style="font-size: 60px; white-space: pre-wrap; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;" />
                <ui:VisualElement name="bar" style="background-size: 100% 1%; border-left-color: rgba(73, 73, 73, 0.54); border-right-color: rgba(73, 73, 73, 0.54); border-top-color: rgba(73, 73, 73, 0.54); border-bottom-color: rgba(73, 73, 73, 0.54); border-bottom-width: 4px; height: 4px; background-color: rgba(213, 9, 9, 0); border-top-width: 4px; border-right-width: 4px; border-left-width: 4px; width: 100%; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px;" />
                <ui:Label text="Music by nojisuma from Pixabay.&#10;Music by chill_background from Pixabay.&#10;Music by junseo lim from Pixabay.&#10;Music by Noru from Pixabay.&#10;Music by Dubush Miaw from Pixabay.&#10;&apos;Galmuri&apos; by Lee Minseo, SIL Open Font License&#10;&apos;Best Ten&apos; by Flop Design, SIL Open Font License" style="font-size: 36px; -unity-text-align: middle-left;" />
            </ui:VisualElement>
            <ui:Label text="Special thanks to all the creators and contributors who made this possible." style="font-size: 36px;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" focusable="true" name="button-back" class="button-skyblue" style="position: absolute; top: 40px; left: 41px; width: 100px; height: 100px; background-image: url(&quot;project://database/Assets/ThirdParty/UI%20button%20pack%203/white%20icon/back.png?fileID=2800000&amp;guid=64619ef912cd2e4419cc3e3e090ac5f8&amp;type=3#back&quot;); -unity-background-image-tint-color: rgb(0, 0, 0);" />
</ui:UXML>
