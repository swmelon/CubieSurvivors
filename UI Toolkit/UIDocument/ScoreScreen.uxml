<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Local/UI%20Toolkit/USS/SampleStyle.uss?fileID=7433441132597879392&amp;guid=b7387224b11979345bd1dd1a944d2ffd&amp;type=3#SampleStyle" />
    <Style src="project://database/Assets/Local/UI%20Toolkit/USS/ColorTheme.uss?fileID=7433441132597879392&amp;guid=5f449be13991f274f900f27f34ccb9a7&amp;type=3#ColorTheme" />
    <ui:VisualElement name="score-screen-overlay" style="width: 100%; height: 100%; position: absolute; left: 0; top: 0; align-items: center; justify-content: flex-start; opacity: 1; flex-direction: row;">
        <ui:VisualElement style="width: 30%; height: 100%;" />
        <ui:VisualElement name="score-screen-background" class="settings-screen-background" style="opacity: 1; display: flex; transition-property: opacity; transition-duration: 0.3s; font-size: 20px; top: auto; left: auto; width: 40%; height: 100%; flex-direction: column; justify-content: center; align-items: center;">
            <ui:VisualElement class="label-title" style="height: 250px; width: 600px; bottom: 20px; align-items: center; justify-content: center; top: 0; margin-top: 15px; margin-bottom: 15px;">
                <ui:Label tabindex="-1" text="9999999999" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-total-score" style="font-size: 72px;" />
            </ui:VisualElement>
            <ui:VisualElement name="score-table" class="label-title" style="width: 100%; height: 50%; top: auto; flex-direction: column; margin-top: 15px; margin-bottom: 15px;">
                <ui:VisualElement name="row" style="flex-grow: 1; flex-direction: row;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 1; justify-content: center; width: 50%;">
                        <ui:Label tabindex="-1" text="Total Damage" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-total-damage" style="-unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=6c21aac34a65cdb4e8dea48dfdb22b12&amp;type=3#NotInter-Regular&quot;);" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; justify-content: center; width: 50%;">
                        <ui:Label tabindex="-1" text="141290" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-total-damage-number" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="row" style="flex-grow: 1; flex-direction: row;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 1; justify-content: center; width: 50%;">
                        <ui:Label tabindex="-1" text="Upgrades" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-boss-count" style="-unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=6c21aac34a65cdb4e8dea48dfdb22b12&amp;type=3#NotInter-Regular&quot;);" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; justify-content: center; width: 50%;">
                        <ui:Label tabindex="-1" text="3" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-boss-count-number" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="row" style="flex-grow: 1; flex-direction: row;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 1; justify-content: center; width: 50%;">
                        <ui:Label tabindex="-1" text="Boss Killed" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-revived" style="-unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=6c21aac34a65cdb4e8dea48dfdb22b12&amp;type=3#NotInter-Regular&quot;);" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; justify-content: center; width: 50%;">
                        <ui:Label tabindex="-1" text="1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-revived-number" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="row" style="flex-grow: 1; flex-direction: row;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 1; justify-content: center; width: 50%;">
                        <ui:Label tabindex="-1" text="Time" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-time" style="-unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=6c21aac34a65cdb4e8dea48dfdb22b12&amp;type=3#NotInter-Regular&quot;);" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; justify-content: center; width: 50%;">
                        <ui:Label tabindex="-1" text="18:31" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label-time-number" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="VisualElement" style="justify-content: flex-start; height: 200px;">
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="button-bottom" class="button-skyblue" style="height: 150px; width: 400px; position: relative;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="width: 30%; height: 100%;" />
    </ui:VisualElement>
</ui:UXML>
