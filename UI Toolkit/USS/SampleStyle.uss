}

.bar-attack .unity-progress-bar__progress {
    background-color: rgb(119, 221, 119);
}

.bar-health .unity-progress-bar__progress {
    background-color: rgb(255, 105, 97);
}

.bar-defense .unity-progress-bar__progress {
    background-color: rgb(253, 253, 150);
}

.bar-agility .unity-progress-bar__progress {
    background-color: rgb(174, 198, 207);
}

.unity-progress-bar__container {
    min-height: 10px;
    height: 40px;
    max-height: 40px;
}

.unity-progress-bar__progress {
    height: 38px;
    margin: 0;
}

.unity-progress-bar__background {
    border-radius: 3px;
    background-color: rgb(68, 68, 68);
}

.button-stage {
    background-image: url("project://database/Assets/Local/Art/IconExports/EventStage1.png?fileID=2800000&guid=5aca7bd29440b80489ca91bc5d65351a&type=3#EventStage1");
    width: 400px;
    height: 400px;
    justify-content: flex-end;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    background-color: rgba(171, 171, 171, 0.33);
}

.button-stage:focus {
    background-image: url("project://database/Assets/Local/Art/IconExports/EventStage1.png?fileID=2800000&guid=5aca7bd29440b80489ca91bc5d65351a&type=3#EventStage1");
    width: 440px;
    height: 440px;
    justify-content: flex-end;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    background-color: rgba(171, 171, 171, 0.33);
    transition-duration: 0.1s;
    transition-timing-function: ease-in-cubic;
}

.bar {
}

.bar-stat-card {
