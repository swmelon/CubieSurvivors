    border-bottom-width: 10px;
    border-left-width: 10px;
}

.button_shelf_slot_frame:focus {
    scale: 1.1 1.1;
    transition-duration: 0.1s;
    transition-timing-function: ease-in;
    border-left-color: rgba(147, 255, 153, 0.24);
    border-right-color: rgba(147, 255, 153, 0.24);
    border-top-color: rgba(147, 255, 153, 0.24);
    border-bottom-color: rgba(147, 255, 153, 0.24);
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
}

